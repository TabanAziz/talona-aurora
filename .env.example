# Copy to .env. Never commit .env.
# The prepared example uses simulated external services. Live mode requires credentials.

LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=deepseek-v4-1-flash-1017
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
# Time zone the crews speak in; extraction converts their times to UTC. Default Europe/Berlin.
# SITE_TIMEZONE=Europe/Berlin
# Site-time hour at which the first ingested event sends the day's report to the superintendent. Default 17.
# DAILY_REPORT_HOUR=17
# Site-time hour for tomorrow's crew briefings. Background delivery requires live channels. Default 16.
# BRIEFING_HOUR=16

# Keys for live mode. Uncomment and fill in.
# MISTRAL_API_KEY=
# ELEVENLABS_API_KEY=
# Voice used for the spoken crew briefings; without it the app speaks with ElevenLabs' Sarah. Default empty.
# ELEVENLABS_VOICE_ID=
# Characters the spoken crew briefings may send to ElevenLabs per day; above it a briefing stays text. Default 40000.
# SPEECH_DAILY_CHARS=40000
# TELEGRAM_BOT_TOKEN=
# Secret token of the webhook (1 to 256 characters of A-Z a-z 0-9 _ -), the same value given to setWebhook.
# With it set, the webhook refuses updates that do not carry it. Unset: every update is accepted.
# TELEGRAM_WEBHOOK_SECRET=
# Group chat for crew notices (a negative number); without it Aurora answers in the chat it last heard from.
# TELEGRAM_CHAT_ID=
# Private jury demo: guest link, role selection and bounded messages. Disabled by default.
# TELEGRAM_BOT_USERNAME=
# GUEST_MODE=false
# GUEST_LIMIT=10
# Real Telegram ids, mail addresses and WhatsApp numbers of people and crews, as one line of JSON
# Adds to the untracked file DATA_DIR/directory.json.
# LIVE_DIRECTORY=
# EMAIL_ADDRESS=
# EMAIL_APP_PASSWORD=
# MARITIME_API_KEY=
# The address a printed sheet label's QR code points at (no trailing slash). The deploy writes the machine's own
# address into the hosted build; set it here to print a label from this laptop that a phone can scan.
# VITE_PUBLIC_URL=https://<machine id>.mtm.sh
# ADAPTION_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Live smoke test only: a separate mail account sends the test to the project mailbox.
# Never copied to the hosted app.
# SMOKE_EMAIL_FROM=
# SMOKE_EMAIL_APP_PASSWORD=
# SMOKE_SMTP_HOST=smtp.gmail.com
# SMOKE_BASE_URL=

# External services are simulated unless explicitly set to false.
# USE_MOCK_LLM=false
# USE_MOCK_VOICE_API=false
# USE_MOCK_TELEGRAM_API=false
# USE_MOCK_EMAIL_API=false
# USE_MOCK_WHATSAPP_API=false
# LLM_RECORD=true saves real model answers as replay files under mocks/llm/.

# Override a backend module with USE_MOCK_<AREA>=true or false.

# Local Telegram polling requires an explicit project channel assignment.
TELEGRAM_POLL_ENABLED=false
