{
  "about": "Golden cases for fact extraction. Synthetic messages for the fictional Maple Court project. A case either names a scenario event or carries its own event. `expect` lists the specific facts (every type except other) the message states; an empty list means no specific fact is correct. Text values compare without case.",
  "cases": [
    {
      "id": "g01-revision",
      "scenario_event": "e01",
      "expect": [{"type": "drawing_revision", "data": {"sheet": "A-201", "revision": "C", "replaces": "B", "units": ["3B"]}}]
    },
    {
      "id": "g02-voice-plan",
      "scenario_event": "e02",
      "expect": [{"type": "work_planned", "data": {"unit": "3B", "crew": "Framing crew", "task": "T-031", "sheet": "A-201", "revision": "B", "start": "2026-11-13T06:00:00Z"}}]
    },
    {
      "id": "g03-trucks",
      "scenario_event": "e03",
      "expect": [{"type": "delivery_actual", "data": {"item": "Concrete trucks", "planned": 3, "actual": 4, "date": "2026-11-13"}}]
    },
    {
      "id": "g04-crane",
      "scenario_event": "e04",
      "expect": [{"type": "equipment_actual", "data": {"item": "Mobile crane", "planned_date": "2026-11-13", "actual_date": "2026-11-16"}}]
    },
    {
      "id": "g05-inspection-moved",
      "scenario_event": "e05",
      "expect": [{"type": "inspection_moved", "data": {"unit": "2A", "inspection": "Rough plumbing", "new_time": "2026-11-13T13:00:00Z"}}]
    },
