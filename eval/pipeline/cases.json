{
  "about": "Fixed end-to-end cases for the detection pipeline. Synthetic messages for the fictional Maple Court project. Each case starts from the project's baseline, ingests its events in order and states which flags should exist afterwards. `messages` is a library; an event names one with `msg` and gives its own id and sent_at. A flag is expected when a flag of the same type exists whose `affected` values include the listed ones. Any other flag is a false alarm. This file is the only place the expected answers live.",
  "messages": {
    "rev_c": {"channel": "email", "sender": "Dana Whitfield", "sender_role": "Architect", "subject": "A-201 Rev C issued", "text": "Attached A-201 Rev C. The partition between bedroom and living room in 3B shifts 300 mm north. Rev C replaces Rev B.", "attachments": [{"kind": "pdf", "name": "A-201-RevC.pdf", "url": "/media/mock/a201-rev-c.svg", "media_type": "application/pdf"}]},
    "work_3b_rev_b": {"channel": "telegram", "sender": "Marco Ruiz", "sender_role": "Framing foreman", "thread": "Maple Court site", "text": "Starting the 3B partitions tomorrow at seven, per A-201 rev B."},
    "work_3b_plain": {"channel": "telegram", "sender": "Marco Ruiz", "sender_role": "Framing foreman", "thread": "Maple Court site", "text": "Starting the 3B partitions tomorrow at seven."},
    "work_3b_rev_c": {"channel": "telegram", "sender": "Marco Ruiz", "sender_role": "Framing foreman", "thread": "Maple Court site", "text": "Starting the 3B partitions tomorrow at seven, per A-201 rev C."},
    "work_2a_plain": {"channel": "telegram", "sender": "Marco Ruiz", "sender_role": "Framing foreman", "thread": "Maple Court site", "text": "Starting the 2A partitions tomorrow at seven."},
    "ack_c": {"channel": "telegram", "sender": "Marco Ruiz", "sender_role": "Framing foreman", "thread": "Maple Court site", "text": "Got A-201 Rev C, thanks. The framing crew has it now."},
    "trucks_4": {"channel": "email", "sender": "Ridgeline Concrete dispatch", "sender_role": "Supplier", "subject": "Friday pour: 4 trucks", "text": "Confirming Friday's podium topping pour. We are sending 4 trucks instead of 3, the mix volume was revised. First truck on site 7:00."},
    "trucks_3": {"channel": "email", "sender": "Ridgeline Concrete dispatch", "sender_role": "Supplier", "subject": "Friday pour: 3 trucks", "text": "Confirming Friday's podium topping pour: 3 trucks as planned. First truck on site 7:00."},
    "trucks_2": {"channel": "email", "sender": "Ridgeline Concrete dispatch", "sender_role": "Supplier", "subject": "Friday pour: 2 trucks", "text": "Confirming Friday's podium topping pour. We can only send 2 trucks, the others are booked elsewhere. First truck on site 7:00."},
    "crane_mon": {"channel": "telegram", "sender": "Lena Ortiz", "sender_role": "Crane operator", "thread": "Maple Court site", "text": "Heads up, the mobile crane gets to site Monday, not Friday. The transport permit slipped."},
    "crane_tue": {"channel": "telegram", "sender": "Lena Ortiz", "sender_role": "Crane operator", "thread": "Maple Court site", "text": "Heads up, the mobile crane will only be on site Tuesday, not Friday. The transport permit slipped."},
    "crane_ok": {"channel": "telegram", "sender": "Lena Ortiz", "sender_role": "Crane operator", "thread": "Maple Court site", "text": "The mobile crane is on site Friday morning as planned."},
    "insp_moved_2a": {"channel": "schedule", "sender": "Schedule update", "text": "Unit 2A rough plumbing inspection moved from Thursday to Friday 14:00."},
    "insp_passed_2a": {"channel": "email", "sender": "City plumbing inspector", "sender_role": "Plumbing inspector", "subject": "Maple Court 2A", "text": "Rough plumbing in unit 2A passed. Signed off today at 13:40."},
    "q_close_2a": {"channel": "telegram", "sender": "Priya Shah", "sender_role": "Drywall foreman", "thread": "Maple Court site", "text": "Can we close the walls in 2A this morning?"},
    "q_close_2a_now": {"channel": "telegram", "sender": "Priya Shah", "sender_role": "Drywall foreman", "thread": "Maple Court site", "text": "Can we close the walls in 2A now?"},
    "plan_close_2a": {"channel": "telegram", "sender": "Priya Shah", "sender_role": "Drywall foreman", "thread": "Maple Court site", "text": "We will close the walls in 2A at seven tomorrow morning."},
    "q_close_1c": {"channel": "telegram", "sender": "Priya Shah", "sender_role": "Drywall foreman", "thread": "Maple Court site", "text": "And 1C, can we close the walls there?"},
    "chat_thanks": {"channel": "telegram", "sender": "Priya Shah", "sender_role": "Drywall foreman", "thread": "Maple Court site", "text": "Thanks everyone, good week. See you Monday."},
    "chat_ok": {"channel": "telegram", "sender": "Priya Shah", "sender_role": "Drywall foreman", "thread": "Maple Court site", "text": "Ok thanks"},
    "chat_weather": {"channel": "telegram", "sender": "Lena Ortiz", "sender_role": "Crane operator", "thread": "Maple Court site", "text": "Cold one this morning, wear your gloves."},
    "q_truck_time": {"channel": "telegram", "sender": "Sam Okafor", "sender_role": "Site labor foreman", "thread": "Maple Court site", "text": "What time does the first truck get here on Friday?"}
